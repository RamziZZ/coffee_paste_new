APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=coffee_paste_pos
DB_SSLMODE=disable

JWT_SECRET=your_jwt_secret_here

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_MERCHANT_NAME=Coffee Paste
MIDTRANS_ENVIRONMENT=sandbox

# Google OAuth (Login with Google)
# Client ID dari Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging (Push Notification)
# Path ke file service account JSON dari Firebase Console -> Project Settings -> Service Accounts
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
